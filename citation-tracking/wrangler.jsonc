{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharos-citation-tracking",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pharos-citation-tracking",
      "database_id": "2fff74f3-857b-47c9-917f-d03cfb93f063"
    }
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "10,30,50 * * * *",
      "0 14 1 * *"
    ]
  },
  // F2 v6.1 — cross-Worker dispatch target for Day-N audit fire (D19).
  // INTERNAL_FULFILL_KEY is set as a SECRET via `wrangler secret put` (shared value with marketing-site).
  "vars": {
    "MARKETING_SITE_URL": "https://astrant.io",
    // SYNC WITH marketing-site/wrangler.jsonc :MAX_PROBE_TARGETS
    // SYNC WITH citation-tracking/wrangler.jsonc :MAX_PROBE_TARGETS
    "MAX_PROBE_TARGETS": "30",
    // B1.3 v1.1 — operator alert recipient (vars per N2-v3; email is not a credential).
    "OPERATOR_ALERT_TO": "taunos@gmail.com"
  },
  // F-Fnd: [env.dev] is for Case 7 smoke test ONLY. Production wrangler deploy uses
  // top-level config (no ENV; no [env.dev]); test endpoint returns 404. If other handlers
  // exercised under "wrangler dev --env dev" need top-level bindings (KV, R2, secrets,
  // etc.), re-declare them here — top-level bindings don't inherit into env blocks.
  "env": {
    "dev": {
      "vars": {
        "ENV": "local"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pharos-citation-tracking",
          "database_id": "2fff74f3-857b-47c9-917f-d03cfb93f063"
        }
      ]
    }
  }
}
