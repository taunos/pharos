{
  // Pharos brand MCP server — Cloudflare Workers config.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharos-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "mcp.astrant.io", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": {
    // Audit checkout gate (fail-closed: only "true" = open). Picks the
    // get_pricing notes wording. MUST be flipped together with
    // marketing-site/wrangler.jsonc AUDIT_CHECKOUT_ENABLED.
    "AUDIT_CHECKOUT_ENABLED": "true"
  },
  // Per-client-IP budget for the tools that fetch a user-supplied site
  // (check_llms_txt, score_url). Keyed on CF-Connecting-IP in src/index.ts.
  // namespace_id is an account-unique integer chosen here; no other Worker
  // in this repo declares one.
  "ratelimits": [
    {
      "name": "FETCH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // E8: score_url calls pharos-scanner's ScanRpc entrypoint (RPC only, not
  // reachable over HTTP) with the end-user IP, so the scanner's per-IP limits
  // apply per MCP user. Deploy pharos-scanner (which exports ScanRpc) first.
  "services": [
    { "binding": "SCANNER", "service": "pharos-scanner", "entrypoint": "ScanRpc" }
  ]
  // NOTE: The original scaffold included a Durable Object binding for
  // `agents/mcp`'s McpAgent session state. It was removed because the
  // installed agents@0.0.50 has a bug in its `mount()` path (double-connect
  // of the McpServer transport) that made it unusable. We now wire the MCP
  // SDK's WebStandardStreamableHTTPServerTransport directly into fetch, which
  // is stateless and needs no DO. Add `durable_objects` + `migrations` back
  // if you later need cross-request session state.
}
