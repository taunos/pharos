{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pharos-marketing",
	"main": "worker.ts",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Custom-domain routes on the astrant.io zone. The workers.dev URL stays
	// available in parallel (Cloudflare exposes it for any deployed Worker
	// regardless of `routes`). Don't disable workers.dev yet — it's a useful
	// debug fallback during the brand transition.
	"routes": [
		{ "pattern": "astrant.io", "custom_domain": true },
		{ "pattern": "www.astrant.io", "custom_domain": true }
	],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// E2 (2026-11-05): first, best-effort burst gate on /api/score/capture-email
	// (3 per 60 s, keyed per IP hash and per scan); the KV hourly/daily limits
	// stay behind it. namespace_id is account-unique: mcp-server 1001,
	// scanner 1002.
	"ratelimits": [
		{
			"name": "CAPTURE_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	// Marketing → scanner calls (Score proxy, Score admin client, Audit /
	// Implementation scans) go over this Service Binding to pharos-scanner's
	// default fetch entrypoint (src/lib/scanner-fetch.ts), so they no longer
	// depend on the scanner's workers.dev route (off). Absent binding → scanner.astrant.io.
	"services": [
		{ "binding": "SCANNER_SVC", "service": "pharos-scanner" }
	],
	"kv_namespaces": [
		{
			"binding": "TRIAGE_CACHE",
			"id": "67367c2585304b4f8927c1762c7fd744"
		},
		{
			"binding": "SESSIONS",
			"id": "38690f7816c74546b18ec9828c83ae44"
		},
		{
			"binding": "CORPUS_DEAD_LETTER",
			"id": "89bdae7af4584f6fb4dd3a2286ae1b28"
		},
		{
			"binding": "WAITLIST",
			"id": "0f979c1af12a4456acbb998b239c854f"
		}
	],
	"d1_databases": [
		{
			"binding": "PHAROS_CORPUS",
			"database_name": "pharos_corpus",
			"database_id": "c95451fd-5cb6-4f51-b4e2-bf4f7dd49272"
		},
		{
			"binding": "CITATION_DB",
			"database_name": "pharos-citation-tracking",
			"database_id": "2fff74f3-857b-47c9-917f-d03cfb93f063"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "pharos-audits",
			"binding": "AUDITS"
		}
	],
	"vars": {
		"CF_ACCOUNT_ID": "e265950ef2b3e0e186ffe1c4d2bee4be",
		// SYNC WITH citation-tracking/wrangler.jsonc :MAX_PROBE_TARGETS
		// SYNC WITH marketing-site/wrangler.jsonc :MAX_PROBE_TARGETS
		"MAX_PROBE_TARGETS": "30",
		// F-Fnd: tier-eligibility binding (V-FP-PROD-A bytes-pinned) + copy gate + base URL.
		"STANDARD_PRODUCT_ID": "pdt_0NdQEbaRcrAC3qQuCAlnh",
		"PRO_PRODUCT_ID":      "pdt_0NdQEw8wrcH0nd5OlZ3IJ",
		"F_FND_COPY_LIVE":     "false",
		"ASTRANT_BASE_URL":    "https://astrant.io",
		// Pre-launch gate for paid Implementation checkout. Fail-closed:
		// only the exact string "true" enables it. Flip to "true" at launch.
		"IMPLEMENTATION_CHECKOUT_ENABLED": "false",
		// E4: server-side gate for Standard/Pro subscriptions (webhook
		// subscription.active). Fail-closed: only "true" opens it. Flip together
		// with the /subscriptions CTA consts at launch.
		"SUBSCRIPTION_CHECKOUT_ENABLED": "false",
		// Pre-launch gate for paid Audit checkout (Test C-A). Fail-closed:
		// only the exact string "true" enables it. Paused 2026-11-07 for the
		// report-truthfulness fixes; reopened 2026-11-08 after Citation
		// Visibility v5 (Bruno's decision); paused again 2026-11-10: the release
		// check found the v5 accuracy judge flags correct answers as mix-ups
		// (RD-0102..0106).
		"AUDIT_CHECKOUT_ENABLED": "false",
		// Review hold (lib/audit-review-hold.ts): the first N paid standalone
		// Audit orders are generated but not delivered until released via
		// /api/internal/audit-review. Counted in CITATION_DB.audit_review_holds
		// (migration 0019 — apply BEFORE deploying this). Fail-closed: absent or
		// malformed → 10; "0" = no hold.
		"AUDIT_REVIEW_HOLD_COUNT": "10",
		// /api/audit-create per-IP limit per hour.
		"AUDIT_CHECKOUT_RATE_LIMIT": "5",
		// Test C-B: canonical public origin for links in the Audit buyer email
		// (the Dodo webhook may arrive on the workers.dev host).
		"PUBLIC_ORIGIN": "https://astrant.io"
	},
	// Test C-A: durable Audit fulfillment. Provision BOTH queues before deploy:
	//   npx wrangler queues create astrant-audit-fulfill
	//   npx wrangler queues create astrant-audit-fulfill-dlq
	// worker.ts routes the consumers on batch.queue (src/lib/queue-router.ts).
	// Slice Q: durable Implementation + F2 Day-N fulfillment (kind "impl" /
	// "impl_day"). Provision BOTH queues before deploy:
	//   npx wrangler queues create astrant-fulfill
	//   npx wrangler queues create astrant-fulfill-dlq
	// Rollback: pause delivery on BOTH astrant-fulfill and astrant-fulfill-dlq
	// BEFORE rolling back (a pre-Q version routes unknown queue names to the
	// capture consumer, which throws):
	//   npx wrangler queues pause-delivery astrant-fulfill
	//   npx wrangler queues pause-delivery astrant-fulfill-dlq
	// Both queues STAY PAUSED until a Slice-Q-compatible consumer is deployed
	// again; do not resume them under the rolled-back version. Paused messages
	// are retained for 4 days (the default retention) — redeploy within that
	// window, then resume-delivery on both. Past 4 days messages are lost:
	// recover from D1 (implementation_sessions rows still 'queued'/'processing'
	// → operator replay via /api/impl-fulfill; Day-N re-fires on the next
	// citation-tracking sweep).
	"queues": {
		"producers": [
			{ "binding": "AUDIT_FULFILL_QUEUE", "queue": "astrant-audit-fulfill" },
			{ "binding": "FULFILL_QUEUE", "queue": "astrant-fulfill" }
		],
		"consumers": [
			{
				"queue": "astrant-audit-fulfill",
				"max_batch_size": 1,
				"max_retries": 3,
				"dead_letter_queue": "astrant-audit-fulfill-dlq"
			},
			{
				"queue": "astrant-audit-fulfill-dlq",
				"max_batch_size": 1,
				"max_retries": 10
			},
			{
				"queue": "astrant-fulfill",
				"max_batch_size": 1,
				"max_retries": 3,
				"dead_letter_queue": "astrant-fulfill-dlq"
			},
			{
				"queue": "astrant-fulfill-dlq",
				"max_batch_size": 1,
				"max_retries": 10
			}
		]
	}
}