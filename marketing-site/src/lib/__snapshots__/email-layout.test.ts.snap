        <h1 style="font-size: 18px; color: #18181b; margin: 12px 0 4px 0; letter-spacing: -0.01em; font-weight: 600;">Heading &amp; more</h1>
        <p style="font-size: 13px; color: #71717a; margin: 0;">Sub</p>
      </td>
    </tr>
    <tr>
      <td style="padding-top: 14px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background: #ffffff; border: 1px solid #e4e4e7; border-radius: 6px;">
          <tr>
