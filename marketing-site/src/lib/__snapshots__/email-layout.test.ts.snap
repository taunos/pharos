        </table>
      </td>
    </tr>
    <tr>
      <td style="padding-top: 14px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background: #ffffff; border: 1px solid #e4e4e7; border-radius: 6px;">
          <tr>
            <td style="padding: 20px 24px; font-size: 14px; line-height: 1.6; color: #18181b;">
              <p>Card two</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding: 24px 0 0 0;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background: #ffffff; border: 1px solid #e4e4e7; border-radius: 6px;">
          <tr>
            <td style="padding: 20px; text-align: center;">
              <div style="margin-bottom: 12px;">
                <a href="https://astrant.io/x?a=1&amp;b=2" style="display: inline-block; padding: 12px 24px; background: #f59e0b; color: #000000; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px;">Open it</a>
              </div>
              <div style="font-size: 12px; color: #71717a;">Caption</div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding: 24px 8px 0 8px; text-align: center;">
        <div style="font-size: 12px; color: #71717a; line-height: 1.5;">Line one</div><div style="font-size: 12px; color: #71717a; line-height: 1.5;">Line two</div>
      </td>
    </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>"
`;

