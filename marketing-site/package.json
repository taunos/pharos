{
  "name": "@pharos/marketing-site",
  "version": "0.0.1",
  "private": true,
  "description": "Pharos marketing site — public-facing landing, llms.txt dogfood, waitlist endpoint.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:opennext": "opennextjs-cloudflare build",
    "cf:bundle": "wrangler deploy --dry-run --outdir .open-next/.gate-bundle --metafile .open-next/.gate-bundle/meta.json",
    "cf:gate": "node scripts/worker-bundle-gate.mjs .open-next/.gate-bundle/worker.js .open-next/.gate-bundle/meta.json",
    "cf:build": "npm run cf:opennext && npm run cf:bundle && npm run cf:gate",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "next": "^15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260425.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
